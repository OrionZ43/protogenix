              mainAxisAlignment: MainAxisAlignment.center,
              children: [
                if (onAddTrack != null) ...[
                  _CapsuleButton(
                    icon: Icons.add_rounded,
                    label: 'Добавить трек',
                    color: palette.primary,
                    onTap: onAddTrack!,
